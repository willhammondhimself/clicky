# Lumen does NOT read this file. It documents the keys you can paste into the
# in-app settings panel (menu bar icon → Settings). Keys are stored in the macOS
# Keychain under service "com.willhammond.lumen" and never written to disk here.
#
# Only the ones you use are needed. With none of them, Lumen runs fully local:
# Apple Speech (STT) → Ollama (vision LLM) → Apple voices (TTS).

OPENROUTER_API_KEY=      # https://openrouter.ai/keys — one key for Haiku 5.5, DeepSeek, GLM, Qwen-VL, Gemini…
ANTHROPIC_API_KEY=       # https://console.anthropic.com — only if you pick "Anthropic direct"
ASSEMBLYAI_API_KEY=      # https://www.assemblyai.com — optional streaming STT (default is Apple Speech)
ELEVENLABS_API_KEY=      # https://elevenlabs.io — optional TTS (default is Apple voices)
OPENAI_API_KEY=          # https://platform.openai.com — optional upload-based STT (gpt-4o-transcribe)
